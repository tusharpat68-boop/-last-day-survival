; Engine configuration file.
; Do not edit by hand unless you know what you are doing.

config_version=5

[application]

config/name="LAST DAY: SURVIVAL"
config/description="Open world 3D survival game for Android."
run/main_scene="res://scenes/main/splash.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameState="*res://scripts/core/game_state.gd"
SettingsManager="*res://scripts/core/settings_manager.gd"
MobileInput="*res://scripts/core/mobile_input.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
